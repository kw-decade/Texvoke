{
  "model": "claude-sonnet-5",
  "max_tokens": 2048,
  "system": "你是一个天气助手，回答尽量简短。",
  "messages": [
    {
      "role": "user",
      "content": "旧金山和东京现在天气怎么样？"
    }
  ],
  "tools": [
    {
      "name": "get_weather",
      "description": "查询指定城市的当前天气",
      "input_schema": {
        "type": "object",
        "properties": {
          "city": {
            "type": "string",
            "description": "城市名"
          },
          "unit": {
            "type": "string",
            "enum": ["celsius", "fahrenheit"]
          }
        },
        "required": ["city"],
        "additionalProperties": false
      }
    }
  ],
  "tool_choice": {
    "type": "auto",
    "disable_parallel_tool_use": false
  },
  "temperature": 0.2
}
